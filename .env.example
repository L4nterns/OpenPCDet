LABELCLOUD_DIR=./labelCloud
INFER_DIR=./infer
CHECKPOINTS_DIR=./checkpoints
DATA_DIR=./data
OUTPUT_DIR=./output

# MODEL options: pv_rcnn, pv_rcnn_plusplus, dsvt_pillar, dsvt_voxel
MODEL=pv_rcnn
EXTRA_TAG=
CFG_FILE=

OUT_DIR=data/custom
TRAIN_RATIO=0.8
VAL_RATIO=0.2
SPLIT_SEED=42

# auto uses 2 samples per visible GPU; set a positive integer to override.
BATCH_SIZE=auto
WORKERS=4
NUM_GPUS=auto
MASTER_PORT=18888
EPOCHS=80

AUG_MODE=full
# -1 means no point sampling; set a positive integer for dense scenes.
SAMPLE_POINTS=-1
# DSVT-only IoU branch controls; ignored by PV-RCNN-family models.
DSVT_IOU_HEAD=true
DSVT_IOU_REG_LOSS=true
DSVT_USE_IOU_TO_RECTIFY_SCORE=true
# GT database generation guardrails. 0 means no global point cap.
GT_DATABASE_TARGET_ELEMENTS=4000000
GT_DATABASE_MIN_CHUNK_SIZE=50000
GT_DATABASE_MAX_CHUNK_SIZE=500000
GT_DATABASE_MAX_POINTS=0

CKPT=
# PRETRAINED_MODEL initializes matching weights for fine-tuning; CKPT resumes or runs inference.
PRETRAINED_MODEL=
INPUT_DIR=/workspace/infer
SCORE_THRESH=0.3
PRED_OUT_DIR=

BASE_IMAGE=nvidia/cuda:11.6.2-devel-ubuntu20.04
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com
PYTORCH_WHEEL_BASE=https://mirrors.aliyun.com/pytorch-wheels/cu116
PYG_WHEEL_URL=https://data.pyg.org/whl/torch-1.13.1+cu116.html
